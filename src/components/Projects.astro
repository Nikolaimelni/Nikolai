---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type Props = {
  projects: CollectionEntry<'projects'>[];
};

const { projects } = Astro.props;
---

<div class="carousel" data-carousel>
  <ul class="track" data-track>
    {
      projects.map(({ data }) => (
        <li class="card">
          <div class="shot">
            {data.cover && (
              <Image
                src={data.cover.src}
                alt={data.cover.alt}
                widths={[400, 800]}
                sizes="(min-width: 64rem) 24rem, 85vw"
                loading="lazy"
                decoding="async"
              />
            )}
          </div>

          <div class="body">
            <h3>
              {data.title}
              {data.demo && <span class="badge">Demo</span>}
            </h3>
            <p class="summary">{data.summary}</p>
            <ul class="tags">
              {data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
            <div class="links">
              {data.url && (
                <a class="btn primary" href={data.url} target="_blank" rel="noopener noreferrer">
                  Open project
                </a>
              )}
              <a
                class:list={['btn', { primary: !data.url }]}
                href={data.github}
                target="_blank"
                rel="noopener noreferrer"
              >
                GitHub
              </a>
            </div>
          </div>
        </li>
      ))
    }
  </ul>

  <div class="controls" data-controls hidden>
    <button class="arrow" type="button" data-prev>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m7 7-7-7 7-7"></path></svg>
      <span class="sr">Previous projects</span>
    </button>
    <div class="dots" data-dots></div>
    <button class="arrow" type="button" data-next>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"></path></svg>
      <span class="sr">Next projects</span>
    </button>
  </div>
</div>

<script>
  for (const carousel of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const track = carousel.querySelector<HTMLElement>('[data-track]');
    const prev = carousel.querySelector<HTMLButtonElement>('[data-prev]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-next]');
    const dots = carousel.querySelector<HTMLElement>('[data-dots]');
    const controls = carousel.querySelector<HTMLElement>('[data-controls]');
    if (!track || !prev || !next || !dots || !controls) continue;

    const step = () => {
      const [first, second] = track.children;
      if (!first || !second) return track.clientWidth;
      return second.getBoundingClientRect().left - first.getBoundingClientRect().left;
    };
    const last = () => Math.max(0, Math.round((track.scrollWidth - track.clientWidth) / step()));
    const go = (index: number) => track.scrollTo({ left: index * step() });

    const render = () => {
      const count = last() + 1;
      if (dots.children.length !== count) {
        dots.replaceChildren(
          ...Array.from({ length: count }, (_, i) => {
            const dot = document.createElement('button');
            dot.type = 'button';
            dot.setAttribute('aria-label', `Scroll to project ${i + 1}`);
            dot.addEventListener('click', () => go(i));
            return dot;
          }),
        );
      }

      const current = Math.round(track.scrollLeft / step());
      for (const [i, dot] of [...dots.children].entries()) {
        if (i === current) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      }
      prev.disabled = current === 0;
      next.disabled = current >= count - 1;
      controls.hidden = count < 2;
    };

    let frame = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(render);
    });
    prev.addEventListener('click', () => go(Math.round(track.scrollLeft / step()) - 1));
    next.addEventListener('click', () => go(Math.round(track.scrollLeft / step()) + 1));
    new ResizeObserver(render).observe(track);
  }
</script>

<style>
  .carousel {
    --gap: 1rem;
    --card: 85cqw;
    --bleed: calc(50vw - 50cqw);

    container-type: inline-size;

    @media (width >= 40rem) {
      --gap: 1.5rem;
      --card: calc((100cqw - var(--gap)) / 2);
    }

    @media (width >= 64rem) {
      --card: calc((100cqw - 2 * var(--gap)) / 3);
    }
  }

  .track {
    display: flex;
    gap: var(--gap);
    margin-inline: calc(-1 * var(--bleed));
    padding: 2px var(--bleed);
    scroll-padding-inline: var(--bleed);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;

    @media (prefers-reduced-motion: reduce) {
      scroll-behavior: auto;
    }
  }

  .card {
    display: flex;
    flex: 0 0 var(--card);
    flex-direction: column;
    overflow: hidden;
    scroll-snap-align: start;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    transition: border-color var(--motion) ease;

    &:hover,
    &:focus-within {
      border-color: var(--green);
    }
  }

  .shot {
    aspect-ratio: 16 / 10;
    background: var(--tint);
  }

  .shot :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: start;
    gap: 1rem;
    padding: 1.5rem clamp(1.25rem, 2vw, 1.75rem) 1.75rem;
  }

  h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    font-size: clamp(1.25rem, 1.1rem + 0.4vw, 1.375rem);
    color: var(--green);
  }

  .badge {
    padding: 0.2rem 0.6rem;
    background: var(--tint-strong);
    border: 1px solid var(--tint-edge);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.12em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .summary {
    color: var(--muted);
    font-size: var(--step--1);
    line-height: 1.55;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;

    & li {
      padding: 0.15rem 0.75rem;
      border: 1px solid var(--line);
      border-radius: 999px;
      font-size: 0.8125rem;
      line-height: 1.6;
    }
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.75rem;

    & .btn {
      padding-inline: 1rem;
    }
  }

  .controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;

    &[hidden] {
      display: none;
    }
  }

  .arrow {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--ink);
    cursor: pointer;
    transition:
      border-color var(--motion) ease,
      opacity var(--motion) ease;

    &:hover:enabled {
      border-color: var(--green);
    }

    &:disabled {
      opacity: 0.35;
      cursor: default;
    }

    & svg {
      width: 1.25rem;
      height: 1.25rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
  }

  .dots {
    display: flex;
  }

  .dots :global(button) {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .dots :global(button)::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--line);
    transition: background-color var(--motion) ease;
  }

  .dots :global(button[aria-current])::before {
    background: var(--green);
  }
</style>
