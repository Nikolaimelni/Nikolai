---
import { profile } from '../data/profile';
---

<ol class="roles">
  {
    profile.experience.map((role) => (
      <li>
        <div class="when">
          <span class="years">
            {role.from}&ndash;{role.to}
          </span>
          {role.kind && <span class="kind">{role.kind}</span>}
        </div>

        <div class="what">
          <h3>{role.title}</h3>
          <p class="where">
            {role.company}
            {role.place && <span>, {role.place}</span>}
          </p>
          <ul>
            {role.points.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </div>
      </li>
    ))
  }
</ol>

<style>
  /* A rule down the left rather than a card per job. Cards flatten six years
     of engineering and a three-month traineeship into the same object. */
  .roles {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .roles > li {
    display: grid;
    gap: 0.75rem 2rem;
    padding-left: 1.5rem;
    border-left: 2px solid var(--rule);

    @media (width >= 52rem) {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }

  .roles > li:first-child {
    border-left-color: var(--green);
  }

  .when {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .years {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .kind {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .what {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .where {
    color: var(--muted);
    font-size: var(--step--1);
  }

  /* The global reset strips markers everywhere. This is the one list that
     reads better with them. */
  .what ul {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin: 0.4rem 0 0;
    padding-left: 1.1rem;
    max-width: var(--measure);
    list-style: disc;
  }

  .what li {
    color: var(--ink-soft);
  }

  .what li::marker {
    color: var(--green);
  }
</style>
