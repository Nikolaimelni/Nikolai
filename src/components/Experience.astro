---
import { profile } from '../data/profile';
import Role from './Role.astro';

const current = profile.experience.filter((role) => !role.earlier);
const earlier = profile.experience.filter((role) => role.earlier);
---

<ol class="roles">
  {current.map((role, i) => <Role role={role} latest={i === 0} />)}
</ol>

<details class="earlier">
  <summary>Before front-end: 2016 to 2022</summary>
  <ol class="roles">
    {earlier.map((role) => <Role role={role} />)}
  </ol>
</details>

<style>
  .roles {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .earlier {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  summary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-weight: 600;
    cursor: pointer;
    color: var(--green);
    list-style: none;
    width: fit-content;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    rotate: -45deg;
    translate: 0 -1px;
    transition: rotate var(--motion) ease;
  }

  details[open] summary::before {
    rotate: 45deg;
    translate: 0 -2px;
  }

  details[open] summary {
    margin-bottom: 1.5rem;
  }
</style>
