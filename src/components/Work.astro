---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<ul class="work">
  {
    projects.map(({ data }) => (
      <li class="project">
        <div class="shot">
          <Image src={data.cover} alt={data.coverAlt} widths={[420, 760]} sizes="(max-width: 55rem) 92vw, 44vw" loading="lazy" decoding="async" />
        </div>

        <div class="text">
          <h3>
            {data.url ? (
              <a href={data.url} target="_blank" rel="noopener noreferrer">
                {data.title}
              </a>
            ) : (
              data.title
            )}
            {data.offline && <span class="offline">offline</span>}
          </h3>

          <p>{data.summary}</p>

          <dl>
            <dt>What I did</dt>
            <dd>{data.role}</dd>
            <dt>Result</dt>
            <dd>{data.outcome}</dd>
          </dl>

          <ul class="stack">
            {data.stack.map((tool) => (
              <li>{tool}</li>
            ))}
          </ul>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .work {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  /* A border, not a shadow. These are the only boxed things on the page. */
  .project {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: var(--surface);

    @media (width >= 55rem) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      align-items: center;
    }
  }

  /* Alternate the image side so the list does not read as a stack of identical rows. */
  .project:nth-child(even) .shot {
    @media (width >= 55rem) {
      order: 2;
    }
  }

  .shot :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: 8px;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: start;
  }

  h3 {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
  }

  .offline {
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  p {
    color: var(--muted);
    max-width: 52ch;
  }

  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.35rem 1rem;
    margin: 0;
    font-size: var(--step--1);
  }

  dt {
    font-weight: 600;
    color: var(--green);
    white-space: nowrap;
  }

  dd {
    margin: 0;
    color: var(--muted);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.85rem;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .stack li:not(:last-child)::after {
    content: '·';
    margin-left: 0.85rem;
  }
</style>
