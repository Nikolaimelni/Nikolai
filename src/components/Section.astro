---
type Props = {
  id: string;
  title: string;
  lead?: string;
  shaded?: boolean;
};

const { id, title, lead, shaded = false } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} data-shaded={shaded ? '' : undefined}>
  <div class="head">
    <h2 id={`${id}-title`}>{title}</h2>
    {lead && <p class="lead">{lead}</p>}
  </div>
  <slot />
</section>

<style>
  section {
    padding-block: calc(var(--section-space) / 2);
  }

  /* Paints past the container without touching the layout inside it. */
  section[data-shaded] {
    background: var(--surface);
    box-shadow: 0 0 0 100vw var(--surface);
    clip-path: inset(0 -100vw);
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin-bottom: clamp(1.75rem, 3.5vw, 3rem);
  }

  .lead {
    max-width: var(--measure);
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.45;
  }
</style>
