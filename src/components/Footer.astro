---
import { profile } from '../data/profile';
---

<footer>
  <div class="colophon">
    <h2>About this page</h2>
    <p>I built this site myself with Astro, TypeScript and plain CSS.</p>
    <p>
      <a href={profile.links.source} target="_blank" rel="noopener noreferrer">
        The code is on GitHub
      </a>
    </p>
  </div>

  <div class="line">
    <p>
      <a href={`mailto:${profile.links.email}`}>{profile.links.email}</a>
    </p>
    <p class="meta">{profile.location.city}, {profile.location.country}</p>
  </div>
</footer>

<style>
  footer {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-block: clamp(2.5rem, 5vw, 4rem) 2.5rem;
    border-top: 1px solid var(--rule);
  }

  .colophon {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    max-width: 58ch;
  }

  h2 {
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--green);
  }

  .colophon p {
    color: var(--ink-soft);
  }

  .line {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    font-size: var(--step--1);
  }

  .meta {
    color: var(--muted);
  }

  footer a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
