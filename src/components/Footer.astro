---
import { profile } from '../data/profile';

const year = new Date().getFullYear();
const source = 'https://github.com/Nikolaimelni/Nikolai';
---

<footer>
  <div class="colophon">
    <h2>About this page</h2>
    <p>
      Astro, no CSS framework, 24 KB of HTML and roughly a kilobyte of JavaScript. The version
      before this one was a bought Bootstrap template with my changes written into the compiled
      stylesheet, which held up right until I needed to change something. Fonts still come from
      Google, so the browser makes two extra connections before it can paint. That is the next
      thing I would fix.
    </p>
    <p>
      <a href={source} target="_blank" rel="noopener noreferrer">Read the source</a>
    </p>
  </div>

  <div class="line">
    <p>
      <a href={`mailto:${profile.links.email}`}>{profile.links.email}</a>
    </p>
    <p class="meta">{profile.base} · {profile.authorization} · {year}</p>
  </div>
</footer>

<style>
  footer {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-block: clamp(2.5rem, 5vw, 4rem) 2.5rem;
    border-top: 1px solid var(--rule);
  }

  .colophon {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    max-width: 58ch;
  }

  h2 {
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--green);
  }

  .colophon p {
    color: var(--ink-soft);
  }

  .line {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    font-size: var(--step--1);
  }

  .meta {
    color: var(--muted);
  }

  footer a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
