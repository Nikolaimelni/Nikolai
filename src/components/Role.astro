---
import type { profile } from '../data/profile';

interface Props {
  role: (typeof profile.experience)[number];
  latest?: boolean;
}

const { role, latest = false } = Astro.props;
---

<li class:list={['role', { latest }]}>
  <div class="when">
    <span class="years">
      {role.from}&ndash;{role.to}
    </span>
    <span class="kind">{role.kind}</span>
  </div>

  <div class="what">
    <h3>
      {role.title}, {role.company}
    </h3>
    <p class="where">{role.place}</p>
    <ul>
      {role.points.map((point) => (
        <li>{point}</li>
      ))}
    </ul>
  </div>
</li>

<style>
  .role {
    display: grid;
    gap: 0.75rem 2rem;
    padding-left: 1.5rem;
    border-left: 2px solid var(--rule);

    @media (width >= 52rem) {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }

  .latest {
    border-left-color: var(--green);
  }

  .when {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .years {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .kind,
  .where {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .what {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .what ul {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin: 0.6rem 0 0;
    padding-left: 1.1rem;
    max-width: var(--measure);
    list-style: disc;
  }

  .what li {
    color: var(--ink-soft);
  }

  .what li::marker {
    color: var(--green);
  }
</style>
