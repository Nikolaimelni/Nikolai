---
import { Image } from 'astro:assets';
import mining from '../assets/education/mining.webp';
import tiu from '../assets/education/tiu.webp';
import { profile } from '../data/profile';

const logos = { tiu, mining };
---

<div class="grid">
  <div class="skills">
    {
      profile.skills.map((group) => (
        <div class="group">
          <h3>{group.label}</h3>
          <ul class="items">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="education">
    <h3>Education</h3>
    {
      profile.education.map((school) => (
        <div class="school">
          <Image src={logos[school.logo]} alt="" width={80} loading="lazy" decoding="async" />
          <div>
            <p class="name">{school.school}</p>
            <p class="meta">
              {school.degree}, {school.field}
            </p>
            <p class="meta">
              {school.from}&ndash;{school.to} · {school.place}
            </p>
          </div>
        </div>
      ))
    }

    <div class="group">
      <h3>Languages</h3>
      <dl class="languages">
        {
          profile.languages.map((language) => (
            <>
              <dt>{language.name}</dt>
              <dd>{language.level}</dd>
            </>
          ))
        }
      </dl>
    </div>
  </div>
</div>

<style>
  .grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);

    @media (width >= 55rem) {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }
  }

  .skills,
  .education {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  h3 {
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--green);
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.8rem;
    max-width: 46ch;
    color: var(--ink-soft);
  }

  .items li:not(:last-child)::after {
    content: '·';
    margin-left: 0.8rem;
    color: var(--muted);
  }

  .school {
    display: flex;
    align-items: start;
    gap: 1rem;
  }

  /* The two logos have very different aspect ratios, so pin the box and let
     object-fit sort out the rest. */
  .school :global(img) {
    width: 2.5rem;
    height: 2.5rem;
    object-fit: contain;
    flex-shrink: 0;
  }

  .name {
    font-weight: 600;
  }

  .meta {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .languages {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.2rem 1rem;
    margin: 0;
    font-size: var(--step--1);
  }

  .languages dt {
    font-weight: 600;
  }

  .languages dd {
    margin: 0;
    color: var(--muted);
  }
</style>
