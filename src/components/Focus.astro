---
import { profile } from '../data/profile';
---

<dl class="focus">
  {
    profile.focus.map((item) => (
      <div>
        <dt>{item.title}</dt>
        <dd>{item.text}</dd>
      </div>
    ))
  }
</dl>

<style>
  .focus {
    display: grid;
    gap: 1.75rem 2.5rem;
    margin: 0;
    padding-bottom: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--rule);

    @media (width >= 34rem) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @media (width >= 64rem) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  dt {
    font-size: var(--step-1);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--green);
  }

  dd {
    margin: 0.45rem 0 0;
    color: var(--muted);
    line-height: 1.45;
    text-wrap: pretty;
  }
</style>
