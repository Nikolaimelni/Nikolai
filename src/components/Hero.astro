---
import { Image } from 'astro:assets';
import photo from '../assets/profile.webp';
import { profile } from '../data/profile';
import { withBase } from '../lib/url';
---

<header class="hero" id="main">
  <div class="intro">
    {
      profile.available && (
        <p class="status">
          <span class="dot" aria-hidden="true" />
          {profile.availability}
        </p>
      )
    }

    <h1>{profile.headline} <span class="accent">{profile.headlineAccent}</span></h1>

    <p class="sub">{profile.subhead}</p>

    <div class="actions">
      {/* Was a mailto:, which does nothing visible on a desktop with no mail
          client configured. The form below always works. */}
      <a class="btn primary" href="#contact">Get in touch</a>
      <a class="btn" href={withBase(profile.links.cv)} download>
        Download CV <span class="meta">PDF, 56 KB</span>
      </a>
    </div>
  </div>

  <div class="portrait">
    <Image src={photo} alt={`${profile.name}, front-end developer`} widths={[420, 640, 900]} sizes="(max-width: 60rem) 80vw, 40vw" loading="eager" fetchpriority="high" />
  </div>
</header>

<style>
  .hero {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
    padding-block: clamp(2rem, 6vw, 5rem) clamp(3rem, 8vw, 6rem);

    @media (width >= 60rem) {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }
  }

  .intro {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 1.5rem;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--muted);
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 0.25rem color-mix(in oklab, var(--green) 18%, transparent);
  }

  h1 {
    max-width: 20ch;
  }

  /* The one gradient on the page. Both ends clear AA on either ground. */
  .accent {
    background: linear-gradient(102deg, var(--green), var(--blue));
    background-clip: text;
    color: transparent;
  }

  .sub {
    max-width: 48ch;
    color: var(--ink-soft);
    font-size: var(--step-0);
    line-height: 1.55;

    @media (width >= 48rem) {
      font-size: var(--step-1);
      line-height: 1.45;
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.85rem 1.4rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 140ms ease, background-color 140ms ease;

    &:hover {
      border-color: var(--ink);
    }
  }

  .btn .meta {
    font-weight: 400;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .primary {
    background: var(--green);
    border-color: var(--green);
    color: light-dark(#fff, #08130d);

    &:hover {
      background: color-mix(in oklab, var(--green) 86%, var(--ink));
      border-color: transparent;
    }
  }

  .portrait {
    position: relative;
    justify-self: center;
    width: min(100%, 30rem);
    border-radius: clamp(1rem, 3vw, 2rem);
    background: linear-gradient(135deg, var(--vivid), #1a1eb2);

    /* Nikolai's dot motif, as a background instead of two SVG files. */
    &::before,
    &::after {
      content: '';
      position: absolute;
      width: 3.2rem;
      height: 5rem;
      background-image: radial-gradient(currentColor 1.6px, transparent 1.7px);
      background-size: 0.62rem 0.62rem;
    }

    /* The dots hang outside the frame, which is the detail worth keeping from
       the old site. On a narrow phone that put them off-screen and gave the
       page 23px of sideways drag, so below 48rem they tuck inside instead. */
    &::before {
      color: var(--blue);
      top: 2rem;
      right: 0.9rem;

      @media (width >= 48rem) {
        right: -1.6rem;
      }
    }

    &::after {
      color: var(--vivid);
      bottom: 2rem;
      left: 0.9rem;

      @media (width >= 48rem) {
        left: -1.6rem;
      }
    }
  }

  .portrait :global(img) {
    width: 100%;
    height: auto;
    border-radius: inherit;
  }
</style>
