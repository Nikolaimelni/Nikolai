---
import { Image } from 'astro:assets';
import photo from '../assets/profile.webp';
import { profile } from '../data/profile';

// CV download is off until there is a new PDF. To bring it back, put the file in
// public/ and restore these lines and the link below:
// import { statSync } from 'node:fs';
// import { withBase } from '../lib/url';
// const cvSize = Math.round(statSync(`public${profile.links.cv}`).size / 1024);
---

<header class="hero">
  <div class="intro">
    {
      profile.available && (
        <p class="status">
          <span class="dot" aria-hidden="true" />
          {profile.availability}
        </p>
      )
    }

    <h1>{profile.headline} <span class="accent">{profile.headlineAccent}</span></h1>

    <p class="sub">{profile.subhead}</p>

    <div class="actions">
      <a class="btn primary" href="#contact">Get in touch</a>
      {/*
      <a class="btn" href={withBase(profile.links.cv)} download>
        Download CV <span class="meta">PDF, {cvSize} KB</span>
      </a>
      */}
    </div>
  </div>

  <div class="portrait">
    <Image src={photo} alt={`${profile.name}, front-end developer`} widths={[420, 640, 900]} sizes="(max-width: 60rem) 80vw, 40vw" loading="eager" fetchpriority="high" />
  </div>
</header>

<style>
  .hero {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
    padding-block: clamp(2rem, 6vw, 5rem) clamp(3rem, 8vw, 6rem);

    @media (width >= 60rem) {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }
  }

  .intro {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 1.5rem;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--muted);
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 0.25rem color-mix(in oklab, var(--green) 18%, transparent);
  }

  h1 {
    max-width: 20ch;
  }

  .accent {
    background: linear-gradient(102deg, var(--green), var(--blue));
    background-clip: text;
    color: transparent;
  }

  .sub {
    max-width: 48ch;
    color: var(--ink-soft);
    font-size: var(--step-0);
    line-height: 1.55;

    @media (width >= 48rem) {
      font-size: var(--step-1);
      line-height: 1.45;
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn .meta {
    font-weight: 400;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .portrait {
    position: relative;
    justify-self: center;
    width: min(100%, 30rem);
    border-radius: clamp(1rem, 3vw, 2rem);
    background: linear-gradient(135deg, var(--vivid), var(--vivid-blue));

    &::before,
    &::after {
      content: '';
      position: absolute;
      width: 3.2rem;
      height: 5rem;
      background-image: radial-gradient(currentColor 1.6px, transparent 1.7px);
      background-size: 0.62rem 0.62rem;
    }

    /* Below 48rem the dots would poke past the edge of the screen. */
    &::before {
      color: var(--blue);
      top: 2rem;
      right: 0.9rem;

      @media (width >= 48rem) {
        right: -1.6rem;
      }
    }

    &::after {
      color: var(--vivid);
      bottom: 2rem;
      left: 0.9rem;

      @media (width >= 48rem) {
        left: -1.6rem;
      }
    }
  }

  .portrait :global(img) {
    width: 100%;
    height: auto;
    border-radius: inherit;
  }
</style>
