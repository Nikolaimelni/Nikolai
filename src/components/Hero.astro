---
import { Image } from 'astro:assets';
import { existsSync, statSync } from 'node:fs';
import photo from '../assets/portrait.webp';
import { profile } from '../data/profile';
import { withBase } from '../lib/url';

const cvFile = `public${profile.links.cv}`;
const cvSize = existsSync(cvFile) ? Math.round(statSync(cvFile).size / 1024) : null;
---

<header class="hero">
  <div class="intro">
    <h1>
      <span class="name">I&rsquo;m <span class="accent">{profile.name}</span></span>
      {profile.headline}
    </h1>

    <p class="sub">{profile.subhead}</p>

    <div class="actions">
      <a class="btn primary" href="#contact">Get in touch</a>
      <a class="btn" href="#experience">See experience</a>
      <a class="btn" href={withBase(profile.links.cv)} download>
        Download CV {cvSize !== null && <span class="meta">PDF, {cvSize} KB</span>}
      </a>
    </div>
  </div>

  <div class="photo">
    <Image
      src={photo}
      alt={profile.name}
      widths={[240, 288, 480, 576]}
      sizes="(min-width: 40rem) 18rem, 15rem"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</header>

<style>
  .hero {
    display: grid;
    gap: 2.5rem clamp(3rem, 6vw, 6rem);
    align-items: center;
    padding-block: clamp(2.5rem, 5vw, 4rem) var(--section-space);

    @media (width >= 60rem) {
      grid-template-columns: minmax(0, 1fr) 18rem;
    }
  }

  .intro {
    display: flex;
    flex-direction: column;
    align-items: start;
  }

  .name {
    display: block;
  }

  .accent {
    color: var(--green);
  }

  .sub {
    margin-top: 1.25rem;
    color: var(--ink-soft);
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .actions {
    display: grid;
    gap: 0.75rem;
    width: 100%;
    margin-top: clamp(2rem, 5vw, 4.5rem);

    @media (width >= 30rem) {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      width: auto;
    }
  }

  .meta {
    font-family: var(--font);
    font-weight: 400;
    color: var(--muted);
  }

  .photo {
    width: 100%;
    max-width: 15rem;
    aspect-ratio: 380 / 490;
    overflow: hidden;
    background: var(--tint);

    @media (width >= 40rem) {
      max-width: 18rem;
    }
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
</style>
