---
import { profile } from '../data/profile';

const endpoint = 'https://formspree.io/f/xyyrkzpq';
---

<div class="contact">
  <!-- action and method are real, so the form still posts if the script never runs. -->
  <form id="contact-form" action={endpoint} method="post">
    <div class="field">
      <label for="name">Your name</label>
      <input id="name" name="name" type="text" autocomplete="name" required />
    </div>

    <div class="field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="email" required />
    </div>

    <div class="field">
      <label for="message">What do you need built?</label>
      <textarea id="message" name="message" rows="5" minlength="10" required></textarea>
    </div>

    <button type="submit">Send</button>

    <p class="status" role="status" aria-live="polite" data-status></p>
  </form>

  <aside>
    <p class="promise">I read everything and reply within a day, usually sooner.</p>
    <p class="or">Or skip the form:</p>
    <ul>
      <li><a href={`mailto:${profile.links.email}`}>{profile.links.email}</a></li>
      <li>
        <a href={profile.links.telegram} target="_blank" rel="noopener noreferrer">Telegram</a>
      </li>
      <li>
        <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </li>
    </ul>
  </aside>
</div>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = form?.querySelector<HTMLParagraphElement>('[data-status]');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  if (form && status && button) {
    form.addEventListener('submit', async (event) => {
      if (!form.reportValidity()) return;
      event.preventDefault();

      button.disabled = true;
      status.dataset.state = 'pending';
      status.textContent = 'Sending…';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (!response.ok) throw new Error(String(response.status));

        form.reset();
        status.dataset.state = 'ok';
        status.textContent = 'Sent. I will get back to you within a day.';
      } catch {
        status.dataset.state = 'error';
        status.textContent = `That did not go through. Write to ${'nikolai.melnichenko.fe@gmail.com'} instead and I will see it.`;
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .contact {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;

    /* Grid tracks take their min-content from the longest unbreakable string,
       and the email address is one. Without this the column wins over the
       viewport on a 320px phone. */
    > * {
      min-width: 0;
    }

    @media (width >= 55rem) {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
    }
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    align-items: start;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    width: 100%;
  }

  label {
    font-size: var(--step--1);
    font-weight: 600;
  }

  input,
  textarea {
    width: 100%;
    padding: 0.7rem 0.85rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 8px;
    resize: vertical;

    &:focus-visible {
      border-color: var(--green);
    }

    /* Only scold a field the visitor has actually filled in and left. */
    &:user-invalid {
      border-color: #b3261e;
    }
  }

  button {
    padding: 0.8rem 1.6rem;
    background: var(--green);
    border: 1px solid var(--green);
    border-radius: 8px;
    color: light-dark(#fff, #08130d);
    font-weight: 600;
    cursor: pointer;

    &:disabled {
      opacity: 0.6;
      cursor: progress;
    }
  }

  .status {
    font-size: var(--step--1);
    min-height: 1.4em;

    &[data-state='ok'] {
      color: var(--green);
    }

    &[data-state='error'] {
      color: light-dark(#b3261e, #f08a80);
    }

    &[data-state='pending'] {
      color: var(--muted);
    }
  }

  aside {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    border-left: 2px solid var(--green);
  }

  .promise {
    font-weight: 600;
  }

  .or,
  aside li {
    color: var(--muted);
    font-size: var(--step--1);
    overflow-wrap: anywhere;
  }

  aside ul {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
</style>
