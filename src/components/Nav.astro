---
import { profile } from '../data/profile';

const [first, ...rest] = profile.name.split(' ');

const sections = [
  { id: 'work', label: 'Work' },
  { id: 'experience', label: 'Experience' },
  { id: 'contact', label: 'Contact' },
];
---

<nav aria-label="Sections">
  <a class="brand" href="#main">
    {first} <span class="surname">{rest.join(' ')}</span>
  </a>
  <ul>
    {
      sections.map((section) => (
        <li>
          <a href={`#${section.id}`} data-spy={section.id}>
            {section.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  // Marks the section you are looking at. The page is long enough that without
  // this there is no way to tell where you are. Links work fine without it.
  const links = document.querySelectorAll<HTMLAnchorElement>('nav a[data-spy]');

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        for (const link of links) {
          // An empty aria-current counts as false, so toggleAttribute is not enough.
          if (link.dataset.spy === entry.target.id) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        }
      }
    },
    { rootMargin: '-30% 0px -60% 0px' },
  );

  for (const link of links) {
    const section = link.dataset.spy && document.getElementById(link.dataset.spy);
    if (section) observer.observe(section);
  }
</script>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
    font-size: var(--step--1);

    @media (width < 30rem) {
      gap: 0.75rem;
    }
  }

  .brand {
    font-weight: 800;
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  /* The surname is what breaks the row at 320px, so it goes first. Losing it
     keeps all three links reachable without a burger menu. */
  .surname {
    @media (width < 30rem) {
      display: none;
    }
  }

  ul {
    display: flex;
    gap: 1.25rem;
    font-weight: 600;

    @media (width < 30rem) {
      gap: 0.7rem;
    }
  }

  /* 44px tall so these are real targets on a phone, not 17px lines of text. */
  .brand,
  ul a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  ul a {
    text-decoration: none;
    color: var(--muted);
    border-bottom: 2px solid transparent;

    &:hover {
      color: var(--ink);
    }

    &[aria-current] {
      color: var(--ink);
      border-bottom-color: var(--green);
    }
  }
</style>
