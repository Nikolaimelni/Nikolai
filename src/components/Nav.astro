---
import { profile } from '../data/profile';

type Props = {
  showProjects: boolean;
};

const { showProjects } = Astro.props;

const sections = [
  { id: 'experience', label: 'Experience' },
  { id: 'contact', label: 'Contact' },
];
if (showProjects) sections.unshift({ id: 'projects', label: 'Projects' });

const social = [
  {
