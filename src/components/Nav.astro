---

<nav aria-label="Sections">
  <div class="inner">
    <ul class="sections">
      {
        sections.map((section) => (
          <li>
            <a href={`#${section.id}`} data-spy={section.id}>
              {section.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="end">
      <ul class="social">
        {
          social.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d={link.icon} />
                </svg>
                <span class="sr">{link.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn primary cta" href="#contact">Get in touch</a>
    </div>
  </div>
</nav>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('nav a[data-spy]');
  // All of main, so the hero and Skills clear the mark too.
  const blocks = [...document.querySelectorAll('main > *')];
  const inView = new Set<Element>();

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) inView.add(entry.target);
        else inView.delete(entry.target);
      }
      const current = blocks.find((block) => inView.has(block));
      for (const link of links) {
        // An empty aria-current counts as false, so toggleAttribute is not enough.
        if (link.dataset.spy === current?.id) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }
    },
    { rootMargin: '-30% 0px -60% 0px' },
  );

  for (const block of blocks) observer.observe(block);
</script>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 5;
    container-type: inline-size;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: var(--column);
    min-height: calc(var(--nav-height) - 1px);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .sections {
    display: flex;
    gap: clamp(1.1rem, 3vw, 2.5rem);
    font-weight: 500;

    a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      text-decoration: none;
      border-bottom: 2px solid transparent;

      &:hover {
        color: var(--green);
      }

      &[aria-current] {
        border-bottom-color: var(--green);
      }
    }
  }

  .end {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .social {
    display: none;
    gap: 0.75rem;

    @container (width >= 56rem) {
      display: flex;
    }

    a {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      border: 1px solid var(--rule);
      border-radius: 50%;
      background: var(--surface);
      color: var(--green);
      transition: border-color var(--motion) ease;

      &:hover {
        border-color: var(--green);
      }
    }

    svg {
      width: 1.2rem;
      height: 1.2rem;
      fill: currentColor;
    }
  }

  .cta {
    display: none;

    @container (width >= 34rem) {
      display: inline-flex;
    }
  }
</style>
