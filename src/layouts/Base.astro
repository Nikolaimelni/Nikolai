---
import { Font } from 'astro:assets';
import { profile } from '../data/profile';
import { withBase } from '../lib/url';
import '../styles/tokens.css';
import '../styles/base.css';

type Props = {
  title: string;
  description: string;
  noindex?: boolean;
};

const { title, description, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const home = new URL(withBase('/'), Astro.site).href;
const ogImage = new URL(withBase('/og.png'), Astro.site).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  description: profile.tagline,
  url: home,
  image: ogImage,
  email: profile.links.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: profile.location.city,
    addressCountry: profile.location.countryCode,
  },
  knowsAbout: profile.skills.flatMap((group) => group.items),
  sameAs: [profile.links.github, profile.links.linkedin, profile.links.telegram],
};

// JSON.stringify leaves "</script>" alone, and that would close the tag early.
const jsonLd = JSON.stringify(person).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, ${profile.role}`} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#fbfcfb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1311" media="(prefers-color-scheme: dark)" />

    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />

    <Font cssVariable="--font-jakarta" preload={[{ weight: 400 }]} />

    <script type="application/ld+json" set:html={jsonLd} is:inline />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <style>
      .skip {
        position: absolute;
        left: var(--gutter);
        top: 0;
        z-index: 10;
        padding: 0.6rem 1rem;
        background: var(--surface);
        border: 1px solid var(--rule);
        border-radius: 0 0 6px 6px;
        font-weight: 600;
        transform: translateY(-110%);
        transition: transform var(--motion) ease;

        &:focus-visible {
          transform: translateY(0);
        }
      }
    </style>
  </body>
</html>
