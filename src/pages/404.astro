---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';
---

<Base title="Not here — Nikolai Melnichenko" description="That page does not exist.">
  <main class="lost">
    <p class="code">404</p>
    <h1>That page is not here</h1>
    <p class="hint">
      It may have moved, or it may never have existed. The front page has everything.
    </p>
    <a href={withBase('/')}>Back to the start</a>
  </main>
</Base>

<style>
  .lost {
    max-width: var(--column);
    margin-inline: auto;
    padding: clamp(4rem, 14vh, 9rem) var(--gutter);
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 1rem;
  }

  .code {
    font-size: var(--step-1);
    font-weight: 800;
    color: var(--green);
    font-variant-numeric: tabular-nums;
  }

  .hint {
    max-width: 44ch;
    color: var(--muted);
    font-size: var(--step-1);
  }

  a {
    margin-top: 0.5rem;
    font-weight: 600;
  }
</style>
