---
import Contact from '../components/Contact.astro';
import Experience from '../components/Experience.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Nav from '../components/Nav.astro';
import Proof from '../components/Proof.astro';
import Section from '../components/Section.astro';
import Skills from '../components/Skills.astro';
import Work from '../components/Work.astro';
import { profile } from '../data/profile';
import Base from '../layouts/Base.astro';

const title = `${profile.name}, ${profile.role}`;
const description = profile.subhead;
---

<Base title={title} description={description}>
  <div class="shell">
    <Nav />
    <Hero />
    <Proof />

    <Section
      id="work"
      title="Selected work"
      lead="What each one is, what I did on it, and what changed after."
    >
      <Work />
    </Section>

    <Section id="experience" title="Experience" shaded>
      <Experience />
    </Section>

    <Section id="skills" title="Stack and study">
      <Skills />
    </Section>

    <Section
      id="contact"
      title="Let's talk"
      lead="Hiring, a contract, or a second opinion on a front-end that has got away from you."
    >
      <Contact />
    </Section>

    <Footer />
  </div>
</Base>

<style>
  .shell {
    max-width: var(--column);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
</style>
