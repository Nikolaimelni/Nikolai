---
import { getCollection } from 'astro:content';
import Contact from '../components/Contact.astro';
import Education from '../components/Education.astro';
import Experience from '../components/Experience.astro';
import Focus from '../components/Focus.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Nav from '../components/Nav.astro';
import Projects from '../components/Projects.astro';
import Section from '../components/Section.astro';
import Stack from '../components/Stack.astro';
import { profile } from '../data/profile';
import Base from '../layouts/Base.astro';

const title = `${profile.name}, ${profile.role}`;
const description = profile.tagline;

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base title={title} description={description}>
  <Nav showProjects={projects.length > 0} />

  <div class="shell">
    <main id="main" tabindex="-1">
      <Hero />
      <Focus />

      <Section id="stack" title="Stack">
        <Stack />
      </Section>

      {
        projects.length > 0 && (
          <Section id="projects" title="Skill showcase">
            <Projects projects={projects} />
          </Section>
        )
      }

      <Section id="experience" title="Experience" dark>
        <Experience />
      </Section>

      <Section id="education" title="Education">
        <Education />
      </Section>

      <Section
        id="contact"
        title="Let's talk"
        lead="Hiring, a contract, or a second opinion on a front-end that has got away from you."
      >
        <Contact />
      </Section>
    </main>

    <Footer />
  </div>
</Base>

<style>
  .shell {
    max-width: var(--column);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
</style>
